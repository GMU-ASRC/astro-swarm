; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AstroSwarm"
config/version="0.0.8"
run/main_scene="res://levels/menus/HomeScene.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.09803922, 0.09019608, 0.14117648, 1)
boot_splash/stretch_mode=4
boot_splash/image="uid://c26um1diy7gik"
config/icon="uid://cgiacfo88w4gf"
boot_splash/minimum_display_time=2000

[autoload]

SimulationManager="*res://autoloads/SimulationManager.gd"
GameManager="*res://autoloads/GameManager.gd"
PlayerSettings="*res://autoloads/PlayerSettings.gd"
PlayerData="*res://autoloads/PlayerData.gd"
Leaderboard="*res://autoloads/Leaderboard.gd"
RunUploader="*res://autoloads/RunUploader.gd"
DominationData="*res://autoloads/DominationData.gd"
EvalUploader="*res://autoloads/EvalUploader.gd"
SurviveUploader="*res://autoloads/SurviveUploader.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
